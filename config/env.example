# Environment Variables for QuantStrategies
# Copy this file to .env and fill in your API keys

# Intrinio API Configuration
INTRINIO_API_KEY=your_intrinio_api_key_here

# Alpha Vantage API (optional)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Yahoo Finance (no API key needed)
# YAHOO_FINANCE_ENABLED=true

# Data Provider Settings
DEFAULT_DATA_PROVIDER=intrinio
FTSE_SYMBOL=UKX
DEFAULT_TIMEZONE=Europe/London

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/quant_strategies.log

# Database Configuration (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/quant_strategies

# Strategy Configuration
# DEFAULT_STRATEGY_CONFIG=config/strategy_config.yaml
